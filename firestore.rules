rules_version = '2';

// INTERIM Fase 0 — queste regole POSSONO essere pubblicate sul progetto Firebase
// reale, ma SOLO per il dogfooding interno (docente + colleghi), MAI con
// studenti. Sono aperte (nessun login vero prima della Fase 2) ma con SCADENZA:
// dopo la data qui sotto Firestore rifiuta ogni lettura/scrittura, così un
// deploy interim dimenticato si auto-disattiva invece di restare aperto.
// Se la data si avvicina e la Fase 2 non è pronta: spostala in avanti
// consapevolmente, non lasciarla scadere per caso.
//
// TODO Fase 2 (login vero): sostituire con regole legate a request.auth.
// Principi da implementare allora:
// - un docente legge/scrive solo i propri corsi e i propri quesiti;
// - un quesito è leggibile da altri docenti solo se `condivisa == true`;
// - uno studente scrive solo le proprie risposte, solo per un quiz `attivo`;
// - il campo `corretta` su una risposta non è mai scrivibile dal client:
//   lo scrive solo functions/calcolaPunteggio.js lato server.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 10, 15);
    }
  }
}
