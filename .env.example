# Copiare questo file in .env (non versionato) e compilare i valori reali.
# Sono tutte chiavi PUBBLICHE del progetto Firebase (client-side): non sono segreti
# nel senso classico, ma vanno comunque tenute fuori dal repository per igiene
# e per poter cambiare progetto Firebase (dev/staging/prod) senza toccare il codice.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Sviluppo locale con l'emulatore Firestore (vedi "npm run emu" nel package.json
# alla radice). Con questo a "true" basta impostare VITE_FIREBASE_PROJECT_ID=demo-isaquiz
# e lasciare vuote le altre chiavi Firebase: nessun progetto reale viene contattato.
VITE_USE_FIRESTORE_EMULATOR=true

# Dominio istituzionale a cui restringere il login Google (parametro hd), Fase 2
VITE_GOOGLE_HD_DOMAIN=

# La vera chiave del provider IA NON va qui: vive solo lato server,
# come variabile d'ambiente di Cloud Functions (vedi functions/aiProvider.js).
