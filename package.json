{
  "name": "isaquiz",
  "private": true,
  "description": "Tooling di sviluppo (emulatore Firestore, seed). ui/, data/ e functions/ hanno i propri package.json.",
  "type": "module",
  "scripts": {
    "emu": "firebase emulators:start --project demo-isaquiz --only firestore,auth,functions --import=./.emulator-data --export-on-exit",
    "seed": "node scripts/seed.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:backend": "firebase deploy --only firestore:rules,functions"
  },
  "devDependencies": {
    "firebase-tools": "^13.29.0"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0"
  }
}
